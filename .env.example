# Mother-Agent System Environment Configuration

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

# LLM Provider: ollama | gemini | anthropic | openai (default: ollama)
LLM_PROVIDER=ollama

# Ollama settings (default provider)
# Base URL for your Ollama instance (local or cloud)
OLLAMA_BASE_URL=http://localhost:11434
# API key (required for cloud/hosted Ollama, leave empty for local)
OLLAMA_API_KEY=your-ollama-api-key-here

# Gemini API Key (alternative)
# Get your API key from: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic API Key (alternative)
# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your-api-key-here

# OpenAI API Key (alternative)
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-api-key-here

# ============================================================================
# MOTHER AGENT SETTINGS
# ============================================================================

# LLM model to use (default depends on provider)
#   ollama:   llama3
#   gemini:   gemini-2.0-flash
#   anthropic: claude-sonnet-4-20250514
#   openai:   gpt-4o
LLM_MODEL=llama3

# Maximum execution time in seconds (default: 300 = 5 minutes)
TIMEOUT_SECONDS=300

# Number of retry attempts for failed tasks (default: 3)
MAX_RETRIES=3

# Maximum number of parallel agents (default: 4 for V0)
MAX_PARALLEL_AGENTS=4

# ============================================================================
# MCP SERVER SETTINGS
# ============================================================================

# Ghost MCP Server (Health Monitoring)
GHOST_MCP_HOST=0.0.0.0
GHOST_MCP_PORT=8000

# Inter-Agent MCP Server (Collaboration)
INTER_AGENT_MCP_HOST=0.0.0.0
INTER_AGENT_MCP_PORT=8001

# Health check interval in seconds (default: 0.2 = 200ms)
HEALTH_CHECK_INTERVAL=0.2

# Ghost MCP tick interval in seconds (default: 0.05 = 50ms)
GHOST_MCP_TICK=0.05

# ============================================================================
# WORKSPACE SETTINGS
# ============================================================================

# Working folder for project outputs (default: /tmp/multi_agent_output)
WORKING_FOLDER=/tmp/multi_agent_output

# Output format: tar.gz or directory (default: tar.gz)
OUTPUT_FORMAT=tar.gz

# Preserve temporary files after completion (default: false)
PRESERVE_TEMP_FILES=false

# ============================================================================
# ADVANCED SETTINGS (Optional)
# ============================================================================

# Enable debug logging (default: false)
DEBUG=false

# Log file location (default: ./mother_agent.log)
LOG_FILE=./mother_agent.log

# Maximum log file size in MB (default: 10)
MAX_LOG_SIZE=10

# Enable performance profiling (default: false)
ENABLE_PROFILING=false
